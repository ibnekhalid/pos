# Copy to .env (gitignored) for the production-image stack in devops/.
# Docker Compose (--project-directory . in scripts/deploy-*.sh) auto-loads .env from the repo root
# to fill the ${VAR} placeholders in devops/docker-compose.yml.
#
# On the VM this file is written fresh on every deploy by .github/workflows/deploy.yml from the
# repo secrets RP_POSTGRES_PASSWORD / RP_JWT_SIGNING_KEY and the repo variable RP_PUBLIC_SITE_URL.
# Locally, scripts/deploy-local.ps1 (or .sh) creates one with random values if it's missing.
#
# (The quick dev stack in docker/ has its own docker/.env — see docker/.env.example.)

# Postgres password for the `restaurant` user. Only applied when the database volume is first
# created — changing it later also needs `ALTER USER restaurant PASSWORD '...'` inside postgres.
POSTGRES_PASSWORD=

# JWT signing key, at least 32 bytes: openssl rand -base64 48
# Changing it signs every user out (all existing tokens become invalid).
JWT_SIGNING_KEY=

# Public URL of the website / PWA (no trailing slash). Used for logo URLs on receipts and as the
# allowed CORS origin. Production: https://restaurant.dsnoopdoc.com
PUBLIC_SITE_URL=http://localhost:8096

# Public URL of the API for the native apps. Only the deploy script's final check uses it.
# Production: https://api.restaurant.dsnoopdoc.com
PUBLIC_API_URL=http://localhost:8097

# Optional: creates the first platform administrator on start-up (only if the account doesn't exist).
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=

# Host port rp-web publishes; Nginx Proxy Manager proxies the public domain to it.
WEB_PORT=8096

# Host port rp-api publishes on 127.0.0.1; NPM proxies the API domain to it.
API_PORT=8097

# Desktop update notice (GET /api/desktop-release). On the VM these come from the repo variables
# RP_DESKTOP_LATEST_VERSION / RP_DESKTOP_DOWNLOAD_URL / RP_DESKTOP_MINIMUM_VERSION. Empty = no notice.
# DESKTOP_LATEST_VERSION=0.3
# DESKTOP_DOWNLOAD_URL=https://restaurant.dsnoopdoc.com/downloads/Restaurant-POS-Setup-0.3.exe
# DESKTOP_MINIMUM_VERSION=
# Host folder served at /downloads/ by rp-web (default /root/downloads/restaurant).
# DOWNLOADS_DIR=

# Only needed with devops/docker-compose.pgadmin.yml
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=
