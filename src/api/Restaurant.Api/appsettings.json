{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=restaurant;Username=restaurant;Password=restaurant_dev"
  },
  "Jwt": {
    "Issuer": "RestaurantPos",
    "Audience": "RestaurantPos.Clients",
    "SigningKey": ""
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SessionRefreshTokenHours": 12,
    "PinSessionHours": 12,
    "InviteDays": 7,
    "PinMaxAttempts": 5,
    "PinLockMinutes": 5
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "UserPermitLimit": 600,
    "AnonymousPermitLimit": 120
  },
  "PlatformAdmin": {
    "Email": "",
    "Password": ""
  },
  "FileStorage": {
    "RootPath": "uploads",
    "PublicBaseUrl": "/uploads"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "DesktopRelease": {
    "LatestVersion": "",
    "DownloadUrl": "",
    "MinimumVersion": ""
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/api-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 }
      }
    ]
  },
  "AllowedHosts": "*"
}
