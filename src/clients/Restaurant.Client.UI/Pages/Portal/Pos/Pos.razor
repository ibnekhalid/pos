@page "/app/pos"
@inherits PageBase
@implements IAsyncDisposable
@using Restaurant.Contracts.Customers
@using Restaurant.Contracts.Deals
@using Restaurant.Contracts.Menu
@using Restaurant.Contracts.Orders
@using Restaurant.Contracts.Sessions
@using Restaurant.Contracts.Tables
@using Microsoft.JSInterop
@inject UiInterop Ui
@inject PrintService Printer
@inject LiveUpdates Live
@inject OfflineStore Offline
@inject OfflineSync OfflineSync
@inject DeviceRegistration Device
@inject SessionStore Session
@inject CustomerDisplay Display
@inject IWindowService Window
@using Restaurant.Client.Core.Offline
@using Restaurant.Contracts.Receipts

<PageTitle>@T("nav.pos")</PageTitle>

@if (!User.Can(Permissions.Orders.Create))
{
    <NoAccess />
}
else if (Loading)
{
    <Loading />
}
else if (_session is null)
{
    <EmptyState Icon="time-outline" Title="@T("pos.dayNotStarted")" Text="@T("pos.dayNotStartedText")">
        <a class="rp-btn" href="app/sessions">@T("pos.goToBusinessDay")</a>
    </EmptyState>
}
else if (_menu is not null)
{
    @if (_offline)
    {
        <Notice Kind="warning" Class="rp-mb">
            <span class="rp-strong">@T("offline.banner")</span> @T("offline.bannerText", ("n", WaitingCount.ToString()))
            <button class="rp-link" @onclick="RetryOnlineAsync">@T("offline.tryNow")</button>
        </Notice>
    }
    else if (WaitingCount > 0)
    {
        <Notice Kind="info" Class="rp-mb">@T("offline.waiting", ("n", WaitingCount.ToString())) <a class="rp-link" href="app/pos/offline">@T("offline.view")</a></Notice>
    }
    <div class="rp-pos">
        <nav class="rp-pos-cats" aria-label="@T("pos.categories")">
            <button class="@(_category is null && !_dealsTab ? "active" : "")" @onclick="() => { _category = null; _dealsTab = false; }">@T("pos.all")</button>
            @if (_menu.Deals is { Count: > 0 } && !_offline)
            {
                <button class="@(_dealsTab ? "active" : "")" style="--cat:#7C3AED" @onclick="() => { _dealsTab = true; _category = null; }"><Icon Name="pricetags-outline" Size="16" /> @T("nav.deals")</button>
            }
            @foreach (var category in _menu.Categories)
            {
                <button class="@(_category == category.Id ? "active" : "")" style="@(category.Color is null ? "" : $"--cat:{category.Color}")"
                        @onclick="() => { _category = category.Id; _dealsTab = false; }">@(L.IsRtl && category.NameUr is not null ? category.NameUr : category.Name)</button>
            }
        </nav>

        <section class="rp-pos-items">
            <div class="rp-input-wrap rp-pos-search">
                <Icon Name="search-outline" />
                <input id="pos-search" class="rp-input" placeholder="@T("pos.search")" value="@_search"
                       @oninput="e => _search = e.Value?.ToString()" />
                <span class="rp-kbd">F3</span>
            </div>
            <div class="rp-pos-grid">
                @foreach (var deal in VisibleDeals)
                {
                    <button class="rp-pos-item rp-pos-deal" @onclick="() => PickDeal(deal)" style="--cat:#7C3AED">
                        <span class="rp-pos-item-name">@(L.IsRtl && deal.NameUr is not null ? deal.NameUr : deal.Name)</span>
                        <span class="rp-pos-item-price">@Money(deal.BundlePrice ?? 0)</span>
                        <Badge Kind="info">@T("deals.combo")</Badge>
                    </button>
                }
                @foreach (var item in VisibleItems)
                {
                    var unavailable = item.Availability != MenuAvailability.Available;
                    <button class="rp-pos-item @(unavailable ? "unavailable" : "")" disabled="@unavailable" @onclick="() => Pick(item)"
                            style="@CategoryColor(item.CategoryId)">
                        <span class="rp-pos-item-name">@(L.IsRtl && item.NameUr is not null ? item.NameUr : item.Name)</span>
                        <span class="rp-pos-item-price">@PriceText(item)</span>
                        @if (unavailable) { <Badge Kind="danger">@T($"availability.{item.Availability}")</Badge> }
                    </button>
                }
                @if (!VisibleItems.Any() && !VisibleDeals.Any())
                {
                    <p class="rp-muted">@T("pos.noItems")</p>
                }
            </div>
        </section>

        <aside class="rp-pos-cart">
            @if (_existing is not null)
            {
                <div class="rp-row">
                    <div class="rp-grow">
                        <div class="rp-strong">@T("pos.addingTo", ("number", _existing.OrderNumber))</div>
                        <div class="rp-hint">@T($"orderType.{_existing.Type}")@(_existing.TableLabel is null ? "" : $" · {T("receipt.table")} {_existing.TableLabel}")</div>
                    </div>
                    <RpButton Small Variant="ghost" OnClick="NewOrder">@T("pos.newOrder")</RpButton>
                </div>
                <div class="rp-cart-existing">
                    @foreach (var line in _existing.Lines.Where(l => l.Status == OrderLineStatus.Active))
                    {
                        <div class="rp-receipt-line"><span>@line.Quantity × @line.Name@(line.VariantName is null ? "" : $" ({line.VariantName})")</span><span>@Money(line.LineTotal)</span></div>
                    }
                </div>
            }
            else
            {
                <div class="rp-segmented block">
                    @foreach (var type in new[] { OrderType.DineIn, OrderType.Takeaway, OrderType.Delivery })
                    {
                        <button class="@(_type == type ? "active" : "")" @onclick="() => SetTypeAsync(type)">@T($"orderType.{type}")</button>
                    }
                </div>
                @if (_type == OrderType.DineIn && _tables.Count > 0)
                {
                    <div class="rp-table-picker">
                        @foreach (var table in _tables.Where(t => t.IsActive))
                        {
                            <button class="@(_tableId == table.Id ? "active" : "") @TableClass(table)" @onclick="() => PickTable(table)"
                                    title="@TableTitle(table)">@table.Number</button>
                        }
                    </div>
                }
                @if (_type != OrderType.DineIn || _showCustomer)
                {
                    <div class="rp-grid-2">
                        <TextField Placeholder="@T("pos.customerName")" @bind-Value="_customerName" MaxLength="100" />
                        <TextField Placeholder="@T("pos.customerPhone")" Value="@_customerPhone" ValueChanged="PhoneChangedAsync" Type="tel" Dir="ltr" MaxLength="30" />
                    </div>
                    @if (_customer is not null)
                    {
                        <div class="rp-hint rp-mb"><Icon Name="person-circle-outline" Size="16" /> @T("pos.returningCustomer", ("name", _customer.Name), ("n", _customer.OrderCount.ToString()))</div>
                    }
                }
                else
                {
                    <button class="rp-link rp-mb" @onclick="() => _showCustomer = true">@T("pos.addCustomer")</button>
                }
            }

            <div class="rp-cart-lines">
                @if (!HasItems)
                {
                    <p class="rp-muted rp-center rp-mt">@T("pos.emptyCart")</p>
                }
                @foreach (var entry in _deals)
                {
                    <div class="rp-cart-line">
                        <button class="rp-cart-line-main" @onclick="() => EditDeal(entry)">
                            <span class="rp-strong"><Icon Name="pricetags-outline" Size="14" /> @(L.IsRtl && entry.Deal.NameUr is not null ? entry.Deal.NameUr : entry.Deal.Name)</span>
                            <span class="rp-hint">@string.Join(" + ", entry.Choices.Select(c => c is null ? "?" : $"{c.Item.Name}{(c.Variant is null ? "" : $" ({c.Variant.Name})")}{(c.Modifiers.Count == 0 ? "" : " + " + string.Join(", ", c.Modifiers.Select(m => m.Name)))}"))</span>
                        </button>
                        <div class="rp-stepper small">
                            <button type="button" @onclick="() => ChangeDealQuantityAsync(entry, -1)" aria-label="@T("pos.less")">−</button>
                            <span>@entry.Quantity</span>
                            <button type="button" @onclick="() => ChangeDealQuantityAsync(entry, 1)" aria-label="@T("pos.more")">+</button>
                        </div>
                        <span class="rp-cart-line-total">@Money(entry.Total)</span>
                    </div>
                }
                @foreach (var line in _cart)
                {
                    <div class="rp-cart-line">
                        <button class="rp-cart-line-main" @onclick="() => Edit(line)">
                            <span class="rp-strong">@(L.IsRtl && line.Item.NameUr is not null ? line.Item.NameUr : line.Item.Name)@(line.Variant is null ? "" : $" ({line.Variant.Name})")</span>
                            @if (line.Modifiers.Count > 0) { <span class="rp-hint">+ @string.Join(", ", line.Modifiers.Select(m => m.Name))</span> }
                            @if (line.Notes is not null) { <span class="rp-hint">» @line.Notes</span> }
                        </button>
                        <div class="rp-stepper small">
                            <button type="button" @onclick="() => ChangeQuantityAsync(line, -1)" aria-label="@T("pos.less")">−</button>
                            <span>@line.Quantity</span>
                            <button type="button" @onclick="() => ChangeQuantityAsync(line, 1)" aria-label="@T("pos.more")">+</button>
                        </div>
                        <span class="rp-cart-line-total">@Money(line.Total)</span>
                    </div>
                }
            </div>

            <div class="rp-cart-totals">
                @if (_existing is null && HasItems && !_offline)
                {
                    <div class="rp-coupon">
                        <input class="rp-input rp-boxed" placeholder="@T("pos.coupon")" value="@_coupon" dir="ltr" maxlength="30" aria-label="@T("pos.coupon")"
                               @onchange="CouponChangedAsync" />
                        @if (_coupon is not null && _preview is not null)
                        {
                            @if (CouponApplied) { <Badge Kind="success">@T("pos.couponApplied")</Badge> } else { <Badge Kind="warning">@T("pos.couponNotApplied")</Badge> }
                        }
                    </div>
                }
                @if (_preview is not null && HasItems)
                {
                    <div class="rp-receipt-meta"><span>@T("receipt.subtotal")</span><span>@Money(_preview.Subtotal)</span></div>
                    @foreach (var deal in (_preview.Deals ?? []).Where(d => d.Discount > 0))
                    {
                        <div class="rp-receipt-meta rp-deal-line"><span>@deal.Name@(deal.Quantity > 1 ? $" × {deal.Quantity}" : "")</span><span>-@Money(deal.Discount)</span></div>
                    }
                    @if (_preview.Discount - _preview.DealDiscount > 0) { <div class="rp-receipt-meta"><span>@T("receipt.discount")</span><span>-@Money(_preview.Discount - _preview.DealDiscount)</span></div> }
                    @if (_preview.ServiceCharge > 0) { <div class="rp-receipt-meta"><span>@T("receipt.serviceCharge")</span><span>@Money(_preview.ServiceCharge)</span></div> }
                    @foreach (var tax in _preview.Taxes) { <div class="rp-receipt-meta"><span>@tax.Name @Format.Number(tax.Percent)%</span><span>@Money(tax.Amount)</span></div> }
                    @if (_preview.Rounding != 0) { <div class="rp-receipt-meta"><span>@T("receipt.rounding")</span><span>@Money(_preview.Rounding)</span></div> }
                    <div class="rp-cart-total"><span>@T(_existing is null ? "receipt.total" : "pos.newTotal")</span><span>@Money(_preview.Total)</span></div>
                }
                else if (_existing is not null)
                {
                    <div class="rp-cart-total"><span>@T("pay.due")</span><span>@Money(_existing.Balance)</span></div>
                }
                else
                {
                    <div class="rp-cart-total"><span>@T("receipt.total")</span><span>@Money(0)</span></div>
                }
            </div>

            @if (Error is not null) { <Notice Kind="danger" Class="rp-mt-sm">@Error</Notice> }
            @if (Success is not null) { <Notice Kind="success" Class="rp-mt-sm">@Success</Notice> }
            @foreach (var warning in _stockWarnings) { <Notice Kind="warning" Class="rp-mt-sm">@warning</Notice> }

            <div class="rp-cart-actions">
                <RpButton Variant="secondary" Disabled="!HasItems || !User.Can(Permissions.Orders.SendToKitchen)" Loading="Busy && !_paying"
                          Icon="flame-outline" OnClick="() => SubmitAsync(pay: false)">@T("pos.send") <span class="rp-kbd">F8</span></RpButton>
                <RpButton Disabled="(!HasItems && _existing is null) || !User.Can(Permissions.Payments.Take)" Loading="Busy && _paying"
                          Icon="cash-outline" OnClick="() => SubmitAsync(pay: true)">@T("pos.pay") <span class="rp-kbd">F9</span></RpButton>
            </div>
            <div class="rp-row">
                <RpButton Variant="ghost" Small Class="rp-grow" OnClick="NewOrder">@T("pos.clear") <span class="rp-kbd">F2</span></RpButton>
                <RpButton Variant="ghost" Small Icon="tv-outline" OnClick="OpenDisplayAsync" Title="@T("display.openHint")">@T("display.open")</RpButton>
            </div>
        </aside>
    </div>
}

<ItemOptionsDialog @bind-Line="_editing" Groups="EditingGroups" IsEdit="_editingExisting" OnConfirm="ConfirmLineAsync" />
<DealDialog @bind-Entry="_editingDeal" Menu="_menu" IsEdit="_editingExisting" OnConfirm="ConfirmDealAsync" />
<PaymentDialog @bind-Open="_payOpen" @bind-Order="_payOrder" OnDone="PaidAsync" />
<OfflinePayDialog Open="_offlinePayNumber is not null" OpenChanged="open => { if (!open) _offlinePayNumber = null; }" Number="@_offlinePayNumber"
                  TotalFor="cash => Estimate(cash).Total" Methods="_snapshot?.PaymentMethods ?? []" OnConfirm="OfflinePaidAsync" />

@code {
    [SupplyParameterFromQuery(Name = "order")] public Guid? OrderId { get; set; }

    private PosMenuDto? _menu;
    private BusinessSessionDto? _session;
    private IReadOnlyList<TableDto> _tables = [];

    private static string TableClass(TableDto t) =>
        t.OpenOrderId is not null ? "busy" : t.NeedsCleaning ? "dirty" : t.ReservedAt is not null ? "reserved" : "";

    private string TableTitle(TableDto t) =>
        t.OpenOrderNumber is not null ? T("pos.tableBusy", ("number", t.OpenOrderNumber))
        : t.NeedsCleaning ? T("tables.needsCleaning")
        : t.ReservedAt is { } at ? T("tables.reservedFor", ("name", t.ReservedFor ?? ""), ("time", at.ToLocalTime().ToString("h:mm tt")))
        : T("pos.tableFree");
    private Guid? _category;
    private string? _search;
    private readonly List<CartLine> _cart = [];
    private readonly List<DealCartEntry> _deals = [];
    private bool _dealsTab;
    private DealCartEntry? _editingDeal;
    private string? _coupon;
    private CustomerDto? _customer;
    private IReadOnlyList<string> _stockWarnings = [];
    private OrderType _type = OrderType.DineIn;
    private Guid? _tableId;
    private string? _customerName, _customerPhone;
    private bool _showCustomer;
    private OrderDto? _existing;
    private PriceBreakdownDto? _preview;
    private Guid _requestId = Guid.NewGuid();
    private CancellationTokenSource? _previewDelay;

    private CartLine? _editing;
    private bool _editingExisting;
    private bool _payOpen, _paying;
    private OrderDto? _payOrder;

    private DotNetObjectReference<Pos>? _self;
    private int? _hotkeys;

    private bool HasItems => _cart.Count > 0 || _deals.Count > 0;

    private bool CouponApplied => _preview?.Deals?.Any(d => d.Type != Restaurant.Contracts.Enums.DealType.Bundle && d.Discount > 0) == true;

    private IEnumerable<DealDto> VisibleDeals => (_menu?.Deals ?? [])
        .Where(d => string.IsNullOrWhiteSpace(_search) ? _dealsTab : d.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<PosMenuItemDto> VisibleItems => _dealsTab && string.IsNullOrWhiteSpace(_search) ? [] : (_menu?.Items ?? [])
        .Where(i => string.IsNullOrWhiteSpace(_search)
            ? _category is null || i.CategoryId == _category
            : i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || (i.NameUr?.Contains(_search) ?? false));

    private IReadOnlyList<ModifierGroupDto> EditingGroups => _editing is null || _menu is null ? []
        : _editing.Item.ModifierGroupIds.Select(id => _menu.ModifierGroups.FirstOrDefault(g => g.Id == id)).Where(g => g is not null).Select(g => g!).ToList();

    protected override async Task LoadAsync()
    {
        if (!User.Can(Permissions.Orders.Create)) return;
        OfflineSync.Changed -= OnOfflineChanged;
        OfflineSync.Changed += OnOfflineChanged;
        try
        {
            _session = await Api.GetCurrentSessionAsync();
            if (_session is null) return;

            var menu = Api.GetPosMenuAsync();
            var tables = Api.GetTablesAsync();
            _menu = await menu;
            _tables = await tables;
            _offline = false;
            if (CanOffline)
            {
                OfflineSync.Report(true);
                _ = SaveSnapshotAsync();
            }
        }
        catch (NetworkException) when (CanOffline)
        {
            if (!await UseSnapshotAsync()) throw;
        }
        if (_tables.Count == 0) _type = OrderType.Takeaway;
        if (_offline) return;

        if (OrderId is { } id)
        {
            _existing = await Api.GetOrderAsync(id);
            if (_existing.Status is OrderStatus.Completed or OrderStatus.Cancelled or OrderStatus.Voided) _existing = null;
        }

        Live.OrdersChanged += OnOrdersChanged;
        _ = Live.EnsureConnectedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await PublishDisplayAsync();
        if (_hotkeys is null && _menu is not null)
        {
            _self = DotNetObjectReference.Create(this);
            _hotkeys = await Ui.RegisterHotkeysAsync(_self, "F2", "F3", "F8", "F9");
        }
    }

    [JSInvokable]
    public async Task OnHotkey(string key)
    {
        switch (key)
        {
            case "F2": NewOrder(); break;
            case "F3": await Ui.FocusAsync("pos-search"); break;
            case "F8" when HasItems: await SubmitAsync(pay: false); break;
            case "F9" when HasItems || _existing is not null: await SubmitAsync(pay: true); break;
        }
        StateHasChanged();
    }

    private string PriceText(PosMenuItemDto item) =>
        item.Variants.Count == 0 ? Money(item.Price) : T("pos.from", ("price", Money(item.Variants.Min(v => v.Price))));

    private string CategoryColor(Guid categoryId) =>
        _menu?.Categories.FirstOrDefault(c => c.Id == categoryId)?.Color is { } color ? $"--cat:{color}" : "";

    private void Pick(PosMenuItemDto item)
    {
        var line = new CartLine { Item = item };
        if (item.Variants.Count > 0 || item.ModifierGroupIds.Count > 0)
        {
            _editingExisting = false;
            _editing = line;
            return;
        }
        _ = AddLineAsync(line);
    }

    private void Edit(CartLine line)
    {
        _editingExisting = true;
        _editing = line;
    }

    private void PickDeal(DealDto deal)
    {
        _editingExisting = false;
        _editingDeal = DealCartEntry.For(deal);
    }

    private void EditDeal(DealCartEntry entry)
    {
        _editingExisting = true;
        _editingDeal = entry;
    }

    private async Task ConfirmDealAsync(DealCartEntry entry)
    {
        Success = null;
        if (!_editingExisting) _deals.Add(entry);
        await RefreshPreviewAsync();
    }

    private async Task ChangeDealQuantityAsync(DealCartEntry entry, int delta)
    {
        entry.Quantity += delta;
        if (entry.Quantity <= 0) _deals.Remove(entry);
        else entry.Quantity = Math.Min(20, entry.Quantity);
        await RefreshPreviewAsync();
    }

    private async Task CouponChangedAsync(ChangeEventArgs e)
    {
        _coupon = Blank(e.Value?.ToString())?.ToUpperInvariant();
        await RefreshPreviewAsync();
    }

    /// <summary>A known phone number fills in the customer's name and shows they're a regular.</summary>
    private async Task PhoneChangedAsync(string? phone)
    {
        _customerPhone = phone;
        _customer = null;
        var digits = new string((phone ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length < 10 || _offline) return;
        try
        {
            var found = await Api.SearchCustomersAsync(digits);
            _customer = found.Count == 1 ? found[0] : null;
            if (_customer is not null && string.IsNullOrWhiteSpace(_customerName)) _customerName = _customer.Name;
        }
        catch
        {
            // Lookup is a convenience: the order still links by phone on the server.
        }
    }

    private async Task ConfirmLineAsync(CartLine line)
    {
        if (_editingExisting)
        {
            await RefreshPreviewAsync();
            return;
        }
        await AddLineAsync(line);
    }

    private async Task AddLineAsync(CartLine line)
    {
        Success = null;
        var same = _cart.FirstOrDefault(l => l.SameAs(line));
        if (same is not null) same.Quantity = Math.Min(99, same.Quantity + line.Quantity);
        else _cart.Add(line);
        await RefreshPreviewAsync();
    }

    private async Task ChangeQuantityAsync(CartLine line, int delta)
    {
        line.Quantity += delta;
        if (line.Quantity <= 0) _cart.Remove(line);
        else line.Quantity = Math.Min(99, line.Quantity);
        await RefreshPreviewAsync();
    }

    private async Task SetTypeAsync(OrderType type)
    {
        _type = type;
        if (type != OrderType.DineIn) _tableId = null;
        await RefreshPreviewAsync();
    }

    private void PickTable(TableDto table)
    {
        if (_offline && (table.OpenOrderId is not null || _offlineTables.Contains(table.Id)))
        {
            // Offline there's no adding to an open order: its bill is on the server.
            Error = T("offline.tableBusy", ("number", table.Number));
            return;
        }
        if (table.OpenOrderId is { } openOrder)
        {
            // An occupied table: carry on with its order instead of starting another.
            Nav.NavigateTo($"app/pos?order={openOrder}");
            return;
        }
        _tableId = _tableId == table.Id ? null : table.Id;
    }

    /// <summary>Totals from the server (debounced while tapping). The cart never computes the bill itself.</summary>
    private async Task RefreshPreviewAsync()
    {
        _previewDelay?.Cancel();
        if (!HasItems)
        {
            _preview = null;
            return;
        }
        if (_offline)
        {
            _preview = OfflinePreview();
            return;
        }
        var delay = _previewDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(200, delay.Token);
            _preview = await Api.PreviewPriceAsync(new PricePreviewRequest(_existing?.Type ?? _type, Lines(), null, _existing?.Id,
                _deals.Select(d => d.ToSelection()).ToList(), _existing is null ? _coupon : null));
            Error = null;
        }
        catch (TaskCanceledException)
        {
        }
        catch (NetworkException) when (CanOffline && _existing is null && _deals.Count == 0)
        {
            // The connection dropped: carry on offline from the saved menu.
            if (await UseSnapshotAsync()) _preview = OfflinePreview();
            else Error = T("common.networkError");
        }
        catch (Exception ex)
        {
            Error = Describe(ex);
        }
        StateHasChanged();
    }

    private List<OrderLineRequest> Lines() =>
        _cart.Select(l => new OrderLineRequest(l.Item.Id, l.Variant?.Id, l.Quantity, l.Modifiers.Select(m => m.Id).ToList(),
            string.IsNullOrWhiteSpace(l.Notes) ? null : l.Notes.Trim())).ToList();

    /// <summary>Send: create (or add to) the order and send it to the kitchen. Pay: the same, then take payment.</summary>
    private async Task SubmitAsync(bool pay)
    {
        if (Busy) return;
        if (_offline)
        {
            await SubmitOfflineAsync(pay);
            return;
        }
        _paying = pay;
        OrderDto? order = _existing;

        if (HasItems)
        {
            var deals = _deals.Select(d => d.ToSelection()).ToList();
            var ok = await RunAsync(async () =>
            {
                order = _existing is null
                    ? await Api.CreateOrderAsync(new CreateOrderRequest(_requestId, _type, _type == OrderType.DineIn ? _tableId : null, null,
                        Blank(_customerName), Blank(_customerPhone), null, Lines(), null, SendToKitchen: true, Deals: deals, CouponCode: _coupon,
                        CustomerId: _customer?.Id))
                    : await Api.AddOrderLinesAsync(_existing.Id, new AddOrderLinesRequest(_requestId, Lines(), SendToKitchen: true, Deals: deals));
            });
            if (!ok)
            {
                // The connection dropped while sending. The same request id goes in the outbox, so if the server did get it
                // the sync finds that order instead of making a second one.
                if (Error == T("common.networkError") && CanOffline && _existing is null && _deals.Count == 0 && await UseSnapshotAsync())
                {
                    Error = null;
                    await SubmitOfflineAsync(pay);
                }
                return;
            }

            _requestId = Guid.NewGuid();
            _stockWarnings = order!.StockWarnings ?? [];
            var printError = await Printer.PrintKitchenRoundAsync(order!.Id);
            Success = printError is null
                ? T("pos.sent", ("number", order.OrderNumber))
                : T("pos.sentPrintFailed", ("number", order.OrderNumber), ("error", printError));
        }

        if (pay && order is not null && order.Balance > 0)
        {
            _payOrder = order;
            _payOpen = true;
        }
        else
        {
            ResetCart();
            if (_existing is not null) Nav.NavigateTo("app/pos");
        }
        _tables = await Api.GetTablesAsync();
    }

    // ------------------------------------------------------------ offline (desktop counter PCs, Phase 6)

    private bool _offline;
    private OfflineSnapshot? _snapshot;
    private string? _offlinePayNumber;
    private readonly HashSet<Guid> _offlineTables = [];

    /// <summary>Only a registered counter PC keeps orders offline: it has a device to number them and files to keep them in.</summary>
    private bool CanOffline => Device.Supported && Device.IsRegistered && Device.Info?.TenantId == Session.Current?.TenantId;

    private int WaitingCount => OfflineSync.ForCurrentBranch().Count();

    private async Task SaveSnapshotAsync()
    {
        try
        {
            if (_session is null || _menu is null || Session.Current is not { TenantId: { } tenantId, BranchId: { } branchId }) return;
            var taxes = Api.GetTaxRatesAsync();
            var methods = Api.GetPaymentMethodsAsync();
            var branch = Api.GetBranchAsync(branchId);
            await Offline.SaveSnapshotAsync(new OfflineSnapshot(tenantId, branchId, _session, _menu, _tables, await taxes, await methods, await branch,
                Brand.Branding, Brand.Tenant, DateTimeOffset.UtcNow));
        }
        catch
        {
            // The previous snapshot stays; it is saved again on the next load.
        }
    }

    /// <summary>Switches to offline selling from the last saved menu, if there is one for an open day at this branch.</summary>
    private async Task<bool> UseSnapshotAsync()
    {
        if (_offline) return true;
        if (Session.Current is not { TenantId: { } tenantId, BranchId: { } branchId }) return false;
        var snapshot = await Offline.LoadSnapshotAsync(tenantId, branchId);
        if (snapshot is null || snapshot.Session.Status != SessionStatus.Open) return false;

        _snapshot = snapshot;
        _session ??= snapshot.Session;
        _menu ??= snapshot.Menu;
        if (_tables.Count == 0) _tables = snapshot.Tables;
        _offline = true;
        if (Brand.Branding is null && snapshot.Branding is not null) Brand.Apply(snapshot.Branding);
        OfflineSync.Report(false);
        if (HasItems) _preview = OfflinePreview();
        return true;
    }

    private void OnOfflineChanged() => InvokeAsync(async () =>
    {
        // Back online: reload the live menu, tables and day (the outbox is sent by OfflineSync).
        if (_offline && !OfflineSync.Unreachable && !HasItems) await RetryOnlineAsync();
        StateHasChanged();
    });

    private async Task RetryOnlineAsync()
    {
        try
        {
            var session = await Api.GetCurrentSessionAsync();
            _offline = false;
            _session = session;
            _snapshot = null;
            _offlineTables.Clear();
            OfflineSync.Report(true);
            await ReloadAsync();
            if (HasItems) await RefreshPreviewAsync();
        }
        catch (NetworkException)
        {
            Error = T("offline.stillOffline");
        }
    }

    private OfflineEstimate.Result Estimate(bool cash) =>
        OfflineEstimate.Price(_cart.Select(l => l.Total), _type, cash, _snapshot?.TaxRates ?? [], _snapshot!.Branch);

    private PriceBreakdownDto OfflinePreview()
    {
        var e = Estimate(cash: true);
        return new PriceBreakdownDto(e.Subtotal, 0, e.ServiceCharge, e.ServiceChargePercent, e.Taxes, e.TaxTotal, e.Rounding, e.Total, []);
    }

    /// <summary>Send or Pay while offline: the order is numbered on this PC, kept in its outbox, and its tickets print here.</summary>
    private async Task SubmitOfflineAsync(bool pay)
    {
        Success = null;
        if (_existing is not null) { Error = T("offline.noAdding"); return; }
        if (_deals.Count > 0) { Error = T("offline.noDeals"); return; }
        if (!HasItems || _snapshot is null || Device.Info is null) return;

        var number = await Offline.NextNumberAsync(Device.Info.DeviceId);
        if (pay && User.Can(Permissions.Payments.Take))
        {
            _offlinePayNumber = number;
            return; // continues in OfflinePaidAsync
        }
        await SaveOfflineAsync(number, null);
    }

    private async Task OfflinePaidAsync(OfflinePaymentRequest payment)
    {
        var number = _offlinePayNumber!;
        _offlinePayNumber = null;
        await SaveOfflineAsync(number, payment);
    }

    private async Task SaveOfflineAsync(string number, OfflinePaymentRequest? payment)
    {
        var snapshot = _snapshot!;
        var method = payment is null ? null : snapshot.PaymentMethods.FirstOrDefault(m => m.Id == payment.PaymentMethodId);
        var cash = method?.IsCash ?? true;
        var estimate = Estimate(cash);
        var tableId = _type == OrderType.DineIn ? _tableId : null;
        var table = _tables.FirstOrDefault(t => t.Id == tableId);
        var request = new OfflineOrderRequest(
            new CreateOrderRequest(_requestId, _type, tableId, null, Blank(_customerName), Blank(_customerPhone), null, Lines(), null, SendToKitchen: true),
            number, DateTimeOffset.UtcNow, User.Me!.UserId, snapshot.Session.Id, estimate.Total,
            payment is null ? [] : [payment with { Amount = estimate.Total }], await Printer.CounterRegisterIdAsync());

        var lines = _cart.Select(l => new OfflineReceipts.Line(l.Quantity, l.Item.Name + (l.Variant is null ? "" : $" ({l.Variant.Name})"),
            l.Modifiers.Select(m => m.Name).ToList(), l.Notes, l.Total)).ToList();
        try
        {
            await Offline.AddAsync(new OfflineEntry(Guid.NewGuid(), snapshot.TenantId, snapshot.BranchId, request,
                string.Join(", ", lines.Select(l => $"{l.Quantity} × {l.Name}"))));
        }
        catch (Exception ex)
        {
            // Nothing was kept: say so plainly, the order must not be served on a ticket that won't reach the till.
            Error = T("offline.notSaved", ("error", ex.Message));
            return;
        }

        var cashier = User.Me.FullName;
        var kitchen = OfflineReceipts.Build(PrintKind.KitchenTicket, snapshot, number, _type, table?.Number, cashier, Blank(_customerName), lines, estimate, [],
            T("offline.ticketNote"));
        var printError = await Printer.PrintLocalAsync(kitchen);
        if (payment is not null)
        {
            var change = payment.Tendered is { } tendered ? tendered - estimate.Total : (decimal?)null;
            var receipt = OfflineReceipts.Build(PrintKind.Receipt, snapshot, number, _type, table?.Number, cashier, Blank(_customerName), lines, estimate,
                [new ReceiptPaymentDto(method?.Name ?? "", estimate.Total, payment.Tendered, change, payment.Reference)], T("offline.receiptNote"));
            printError ??= await Printer.PrintLocalAsync(receipt, openDrawer: cash);
        }

        if (tableId is { } taken) _offlineTables.Add(taken);
        if (payment is not null) ShowPaid(number, estimate.Total, payment.Tendered ?? estimate.Total, payment.Tendered is { } given ? given - estimate.Total : 0);
        ResetCart();
        Success = printError is null ? T("offline.saved", ("number", number)) : T("offline.savedPrintFailed", ("number", number), ("error", printError));
    }

    // ------------------------------------------------------------ customer display (Phase 6)

    private string? _displayJson;
    private (string Number, decimal Total, decimal Paid, decimal Change, DateTime Until)? _paidShown;
    private Timer? _paidTimer;

    /// <summary>Desktop: its own window, full screen on the second monitor. Web: a pop-up window to drag to the customer's screen.</summary>
    private async Task OpenDisplayAsync()
    {
        _displayJson = null; // the new window gets the current state at once
        if (!await Window.OpenCustomerDisplayAsync() && !await Ui.OpenWindowAsync("app/display", "rp-customer-display"))
        {
            Error = T("display.blocked");
        }
    }

    /// <summary>After a payment the customer sees the total and their change for 20 seconds, then the welcome screen.</summary>
    private void ShowPaid(string number, decimal total, decimal paid, decimal change)
    {
        _paidShown = (number, total, paid, change, DateTime.UtcNow.AddSeconds(20));
        _paidTimer?.Dispose();
        _paidTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(21), Timeout.InfiniteTimeSpan);
    }

    private CustomerDisplayState DisplayState()
    {
        var name = Brand.DisplayName;
        var language = Brand.Branding?.ReceiptLanguage ?? L.Language;
        CustomerDisplayState Empty(string status) => new(status, name, Brand.LogoUrl, Brand.Primary, Brand.CurrencyCode, language, [], 0, 0, 0, 0, 0);

        if (_paidShown is { } paid && DateTime.UtcNow < paid.Until && !HasItems && _existing is null)
        {
            return Empty("paid") with { Total = paid.Total, Paid = paid.Paid, Change = paid.Change, OrderNumber = paid.Number };
        }
        if (!HasItems && _existing is null) return Empty("idle");

        var lines = (_existing?.Lines.Where(l => l.Status == OrderLineStatus.Active)
                .Select(l => new CustomerDisplayLine(l.Quantity, l.Name, l.VariantName, l.LineTotal)) ?? [])
            .Concat(_deals.Select(d => new CustomerDisplayLine(d.Quantity, d.Deal.Name, null, d.Total)))
            .Concat(_cart.Select(l => new CustomerDisplayLine(l.Quantity, l.Item.Name,
                string.Join(", ", new[] { l.Variant?.Name }.Concat(l.Modifiers.Select(m => m.Name)).Where(x => !string.IsNullOrEmpty(x))) is { Length: > 0 } detail ? detail : null,
                l.Total)))
            .ToList();
        return _preview is { } p
            ? Empty("cart") with { Lines = lines, Subtotal = p.Subtotal, Tax = p.TaxTotal, ServiceCharge = p.ServiceCharge, Discount = p.Discount, Total = p.Total,
                OrderNumber = _existing?.OrderNumber }
            : Empty("cart") with { Lines = lines, Subtotal = _existing?.Subtotal ?? lines.Sum(l => l.Total), Tax = _existing?.TaxTotal ?? 0,
                ServiceCharge = _existing?.ServiceCharge ?? 0, Discount = _existing?.Discount ?? 0, Total = _existing?.Total ?? lines.Sum(l => l.Total),
                OrderNumber = _existing?.OrderNumber };
    }

    /// <summary>Sends the display only what changed (it's called after every render).</summary>
    private async Task PublishDisplayAsync()
    {
        var state = DisplayState();
        var json = System.Text.Json.JsonSerializer.Serialize(state, Restaurant.Client.Core.Json.Options);
        if (json == _displayJson) return;
        _displayJson = json;
        Display.Publish(state);
        await Ui.BroadcastAsync(CustomerDisplay.Channel, json);
    }

    private async Task PaidAsync()
    {
        if (_payOrder is { } paidOrder)
        {
            ShowPaid(paidOrder.OrderNumber, paidOrder.Total, paidOrder.Paid, paidOrder.Payments.Sum(p => p.Change ?? 0));
        }
        ResetCart();
        Success = T("pos.paidDone", ("number", _payOrder?.OrderNumber ?? ""));
        _tables = await Api.GetTablesAsync();
        if (_existing is not null) Nav.NavigateTo("app/pos");
    }

    private void NewOrder()
    {
        ResetCart();
        Success = null;
        Error = null;
        _stockWarnings = [];
        if (_existing is not null) Nav.NavigateTo("app/pos");
    }

    private void ResetCart()
    {
        _cart.Clear();
        _deals.Clear();
        _coupon = null;
        _customer = null;
        _preview = null;
        _tableId = null;
        _customerName = _customerPhone = null;
        _showCustomer = false;
        _requestId = Guid.NewGuid();
        _existing = null;
    }

    private void OnOrdersChanged() => InvokeAsync(async () =>
    {
        try { _tables = await Api.GetTablesAsync(); } catch { /* next time */ }
        StateHasChanged();
    });

    protected override async Task OnParametersSetAsync()
    {
        // Navigating between /app/pos and /app/pos?order=... reuses the page.
        if (!Loading && _session is not null && OrderId != _existing?.Id)
        {
            ResetCart();
            if (OrderId is { } id)
            {
                await ReloadAsync();
            }
        }
    }

    private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    public async ValueTask DisposeAsync()
    {
        _paidTimer?.Dispose();
        OfflineSync.Changed -= OnOfflineChanged;
        Live.OrdersChanged -= OnOrdersChanged;
        if (_hotkeys is { } id) await Ui.UnregisterHotkeysAsync(id);
        _self?.Dispose();
        base.Dispose();
    }
}
