@page "/app/reset-password"
@layout AuthLayout
@inherits PageBase

<PageTitle>@T("reset.title")</PageTitle>

<h1>@T("reset.title")</h1>
@if (_done)
{
    <Notice Kind="success">@T("reset.done")</Notice>
    <a class="rp-btn block rp-mt" href="app/login">@T("auth.signIn")</a>
}
else
{
    @if (Error is not null)
    {
        <Notice Kind="danger" Class="rp-mb">@Error</Notice>
    }
    <TextField Label="@T("register.email")" @bind-Value="Email" Type="email" Dir="ltr" Icon="mail-outline" />
    <TextField Label="@T("reset.code")" @bind-Value="Token" Dir="ltr" Icon="key-outline" />
    <TextField Label="@T("reset.newPassword")" @bind-Value="_password" Type="password" AutoComplete="new-password"
               Hint="@T("auth.passwordRule")" Error="@FieldError("NewPassword")" OnEnter="ResetAsync" />
    <RpButton Block Class="rp-mt" Loading="Busy" OnClick="ResetAsync">@T("reset.save")</RpButton>
}
<div class="rp-auth-alt"><a href="app/login">@T("auth.backToSignIn")</a></div>

@code {
    private string? _password;
    private bool _done;

    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    private async Task ResetAsync() =>
        _done = await RunAsync(() => Api.ResetPasswordAsync(new ResetPasswordRequest(Email?.Trim() ?? "", Token?.Trim() ?? "", _password ?? "")));
}
