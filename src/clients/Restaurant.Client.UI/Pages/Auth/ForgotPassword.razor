@page "/app/forgot-password"
@layout AuthLayout
@inherits PageBase

<PageTitle>@T("forgot.title")</PageTitle>

<h1>@T("forgot.title")</h1>
@if (_sent)
{
    <Notice Kind="success">@T("forgot.sent")</Notice>
    <p class="rp-muted rp-mt">@T("forgot.staffHint")</p>
    <a class="rp-btn secondary block rp-mt" href="app/reset-password">@T("forgot.haveCode")</a>
}
else
{
    <p class="rp-muted">@T("forgot.subtitle")</p>
    @if (Error is not null)
    {
        <Notice Kind="danger" Class="rp-mb">@Error</Notice>
    }
    <TextField Label="@T("register.email")" @bind-Value="_email" Type="email" Dir="ltr" Icon="mail-outline" OnEnter="SendAsync" />
    <RpButton Block Class="rp-mt" Loading="Busy" OnClick="SendAsync">@T("forgot.send")</RpButton>
    <p class="rp-hint rp-mt">@T("forgot.staffHint")</p>
}
<div class="rp-auth-alt"><a href="app/login">@T("auth.backToSignIn")</a></div>

@code {
    private string? _email;
    private bool _sent;

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        _sent = await RunAsync(() => Api.ForgotPasswordAsync(_email.Trim()));
    }
}
