@using System.Reflection
@* The router for both hosts. The web app adds its public-site pages through AdditionalAssemblies. *@
<Router AppAssembly="typeof(Routes).Assembly" AdditionalAssemblies="AdditionalAssemblies" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(AppLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    [Parameter] public IEnumerable<Assembly> AdditionalAssemblies { get; set; } = [];
}
