<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:Restaurant.Client.UI;assembly=Restaurant.Client.UI"
             x:Class="Restaurant.Desktop.MainPage">

    <!-- The shared app from Restaurant.Client.UI; the desktop app opens straight into /app. -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" StartPath="/app">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:AppRoot}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
