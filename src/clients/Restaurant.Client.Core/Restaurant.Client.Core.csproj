<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything the screens need that isn't UI: the typed API client, session, signed-in user,
       branding, localisation and the platform interfaces each host (web, desktop) implements. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\Restaurant.Contracts\Restaurant.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every UI string, English + Urdu (the source of truth — edit here). -->
    <EmbeddedResource Include="Resources\translations.json" LogicalName="Restaurant.translations.json" />
    <!-- Ionicons (MIT) code points, matching wwwroot/fonts/Ionicons.ttf in Restaurant.Client.UI. -->
    <EmbeddedResource Include="Resources\ionicons-glyphs.json" LogicalName="Restaurant.ionicons-glyphs.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

</Project>
